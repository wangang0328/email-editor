{
  "name": "email-editor",
  "scripts": {
    "install-all": "pnpm install",
    "vercel-install": "pnpm install",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "build:localization": "pnpm i18n:compile",
    "build": "pnpm run build:localization && pnpm run build:shared && pnpm run build:ui && pnpm run build:engine && pnpm run build:blocks-react && pnpm run build:editor && pnpm run build:panels && pnpm run build:preset",
    "build:shared": "cd packages/email-editor-shared && pnpm run build",
    "build:ui": "cd packages/email-editor-ui && pnpm run build",
    "build:panels": "cd packages/email-editor-panels && pnpm run build",
    "build:engine": "cd packages/email-editor-engine && pnpm run build",
    "build:blocks-react": "cd packages/email-editor-blocks-react && pnpm run build",
    "build:editor": "cd packages/email-editor-editor && pnpm run build",
    "build:preset": "cd packages/email-editor-preset && pnpm run build",
    "analyze": "pnpm run analyze:blocks-react && pnpm run analyze:editor && pnpm run analyze:panels && pnpm run analyze:preset && pnpm run demo:analyze",
    "analyze:blocks-react": "cd packages/email-editor-blocks-react && pnpm run analyze",
    "analyze:editor": "cd packages/email-editor-editor && pnpm run analyze",
    "analyze:panels": "cd packages/email-editor-panels && pnpm run analyze",
    "analyze:preset": "cd packages/email-editor-preset && pnpm run analyze",
    "dev": "cd demo && pnpm run dev",
    "demo": "cd demo && pnpm run build",
    "demo:analyze": "cd demo && pnpm run analyze",
    "demo:nextjs": "cd simple-nextjs-demo && pnpm run build",
    "test": "pnpm run test:blocks-react && pnpm run test:editor && pnpm run test:panels && pnpm run test:preset",
    "test:blocks-react": "cd packages/email-editor-blocks-react && pnpm run test",
    "test:editor": "cd packages/email-editor-editor && pnpm run test",
    "test:panels": "cd packages/email-editor-panels && pnpm run test",
    "test:preset": "cd packages/email-editor-preset && pnpm run test",
    "translate": "ts-node --project scripts/tsconfig.json scripts/translate.ts",
    "i18n:collect-keys": "ts-node --project scripts/tsconfig.json scripts/i18n/collect.ts",
    "i18n:diff-refs": "ts-node --project scripts/tsconfig.json scripts/i18n/ref-diff.ts",
    "i18n:report-refs": "ts-node --project scripts/tsconfig.json scripts/i18n/ref-sync.ts",
    "i18n:push-draft": "ts-node --project scripts/tsconfig.json scripts/i18n/push.ts",
    "i18n:pull-published": "ts-node --project scripts/tsconfig.json scripts/i18n/pull.ts",
    "i18n:upload-draft": "ts-node --project scripts/tsconfig.json scripts/i18n/sync.ts",
    "i18n:collect": "pnpm run i18n:collect-keys",
    "i18n:diff": "pnpm run i18n:diff-refs",
    "i18n:ref-sync": "pnpm run i18n:report-refs",
    "i18n:push": "pnpm run i18n:push-draft",
    "i18n:pull": "pnpm run i18n:pull-published",
    "i18n:sync": "pnpm run i18n:upload-draft",
    "lint": "lerna exec -- pnpm run format"
  },
  "dependencies": {
    "@sendgrid/mail": "^7.7.0",
    "@types/file-saver": "^2.0.5",
    "cloudinary": "^1.41.2",
    "easy-localized-translation": "^1.1.0",
    "file-saver": "^2.0.5",
    "lerna": "^4.0.0",
    "liquidjs": "^9.34.1",
    "posthog-js": "^1.76.0"
  },
  "pnpm": {
    "overrides": {
      "react": "catalog:",
      "react-dom": "catalog:",
      "@radix-ui/react-slot": "catalog:"
    },
    "patchedDependencies": {
      "@radix-ui/react-slot@1.2.4": "patches/@radix-ui__react-slot@1.2.4.patch"
    }
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@lingui/cli": "catalog:",
    "@lingui/vite-plugin": "catalog:",
    "@types/fs-extra": "^11.0.1",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^5.22.0",
    "dotenv": "^16.0.3",
    "lodash-es": "catalog:",
    "ts-node": "^10.9.2"
  }
}