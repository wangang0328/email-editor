{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@blocks": ["src"],
      "@blocks/*": ["src/*"],
      "@wa-dev/email-editor-shared": ["../email-editor-shared/src/index.ts"],
      "@wa-dev/email-editor-shared/types": ["../email-editor-shared/src/types/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "lib"]
}
