{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vite/client"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@panels": ["./src"],
      "@panels/*": ["./src/*"],
      "@wa-dev/email-editor-editor": ["../email-editor-editor/src/index.tsx"],
      "@wa-dev/email-editor-editor/*": ["../email-editor-editor/src/*"],
      "@wa-dev/email-editor-shared": ["../email-editor-shared/src/index.ts"],
      "@wa-dev/email-editor-shared/types": ["../email-editor-shared/src/types/index.ts"]
    }
  },
  "include": ["./src"],
  "exclude": ["node_modules", "lib"]
}
