  "keywords": [
    "email editor core"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./lib/style.css": "./lib/style.css"
  },
  "scripts": {
    "dev": "vite",
    "typings": "rimraf --glob src/**/*.d.ts src/**/*.d.ts.map && tsc --declaration --emitDeclarationOnly --project tsconfig.lib.json && tsc-alias -p tsconfig.alias.json",
    "build": "rimraf lib && pnpm run typings && vite build --config vite.config.ts",
    "analyze": "cross-env ANALYZE=true vite build --config vite.config.ts",
    "test": "jest --coverage",
    "format": "eslint --fix  --ext .tsx,.ts,.tsx src/"
  },
