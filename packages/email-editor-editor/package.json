{
  "name": "@wa-dev/email-editor-editor",
  "license": "MIT",
  "description": "Email editor UI (based on Easy Email)",
  "version": "2.0.0",
  "author": "wa-dev",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
