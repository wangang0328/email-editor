{
  "name": "@wa-dev/email-editor-preset",
  "license": "MIT",
  "description": "Email editor default UI preset (attribute panel, layout, toolbar)",
  "version": "2.0.4",
  "author": "wa-dev",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wangang0328/email-editor.git"
  },
  "keywords": [
    "email editor core"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./style.css": "./lib/style.css",
    "./lib/style.css": "./lib/style.css"
  },
  "scripts": {
    "dev": "vite",
    "typings": "tsc --declaration --emitDeclarationOnly --project tsconfig.lib.json && tsc-alias -p tsconfig.alias.json",
    "build": "rimraf lib && pnpm run typings && vite build --config vite.config.ts",
    "analyze": "cross-env ANALYZE=true vite build --config vite.config.ts",
    "format": "eslint --fix  --ext .tsx,.ts,.tsx src/",
    "test": "jest  --coverage"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
