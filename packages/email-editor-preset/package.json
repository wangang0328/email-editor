    "rollup-plugin-visualizer": "catalog:",
    "sass": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@wa-dev/email-editor-panels": "workspace:*",
    "@wa-dev/email-editor-shared": "workspace:*",
    "@wa-dev/email-editor-ui": "workspace:*"
  },
